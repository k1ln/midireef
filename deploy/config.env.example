# MidiReef-Deploy — Verbindungs- und Pfaddaten für den Raspberry Pi.
#
# Kopieren nach `deploy/config.env` und anpassen. Die Kopie ist gitignored,
# damit hostspezifische Daten nicht im Repo landen.

# SSH-Ziel. PI_HOST kann ein Hostname (`midireef.local`), eine IP oder ein
# Alias aus ~/.ssh/config sein.
PI_HOST=midireef.local
PI_USER=pi

# Zielverzeichnis auf dem Pi. Hier liegen Binary, ui/, data/ und (nur für den
# Release-Pfad) der Git-Checkout.
PI_DIR=/home/pi/midireef

# Port, auf dem der Rust-Server lauscht (bedient /ws UND das gebaute UI).
MIDIREEF_PORT=8787

# Vite-Dev-Server auf dem Pi (nur im Dev-Modus, liefert HMR).
VITE_PORT=5173

# Git-Remote, den der Release-Pfad auf dem Pi pullt.
GIT_REMOTE=origin
GIT_BRANCH=main
